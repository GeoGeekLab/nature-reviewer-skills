{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "case_id",
    "domain",
    "gold_concerns"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "manuscript_text": {
      "type": "string"
    },
    "gold_concerns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "issue_id",
          "severity",
          "text"
        ],
        "properties": {
          "issue_id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "critical",
              "major",
              "moderate",
              "minor",
              "editorial",
              "unknown"
            ]
          },
          "text": {
            "type": "string"
          },
          "anchors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reviewer_id": {
            "type": "string"
          }
        }
      }
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "suite": {
      "type": "string"
    },
    "case_type": {
      "enum": [
        "positive",
        "negative_control"
      ]
    },
    "pair_id": {
      "type": "string"
    },
    "challenge": {
      "type": "string"
    },
    "target_issue_id": {
      "type": "string"
    },
    "design": {
      "type": "string"
    },
    "source_keys": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "provenance": {
      "type": "object",
      "properties": {
        "synthetic": {
          "type": "boolean"
        },
        "text_origin": {
          "type": "string"
        },
        "gold_status": {
          "type": "string"
        },
        "design_note": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
